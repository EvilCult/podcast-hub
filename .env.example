# Public access URLs (baked into the frontend at build time / absolute URLs returned by the API; used by devices to construct transcoding URLs)
# Default values for local development; set these to your actual public URLs for production/Docker builds.
PUBLIC_HOST=

# Outbound proxy (server-side fetch: iTunes searches / RSS / cover images / audio)
# Three supported formats:
#   PROXY_URL=                          Empty = direct connection (default)
#   PROXY_URL=socks5://127.0.0.1:1080 Specify a proxy directly
#   PROXY_URL=https_proxy               Indirect reference: use the value of the https_proxy environment variable
# no_proxy is still respected.
# Note: This file is only loaded during local Vite development. For Docker deployments,
# configure these variables in the compose environment: section (or via env_file).
# Settings in .env.production will not take effect.
PROXY_URL=
