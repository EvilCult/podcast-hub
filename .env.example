# 公开访问地址（构建时 bake 进前端/接口返回的绝对 URL，设备端靠它拼转码地址）
# 本地开发默认值；生产/Docker 构建请改为实际公网地址
PUBLIC_API_URL=http://localhost:5173
PUBLIC_HOST=http://localhost:5173
# 出站代理（服务端 fetch：iTunes 查询 / RSS / 封面图 / 音频）
# 三种写法：
#   PROXY_URL=                          为空 = 直连（默认）
#   PROXY_URL=socks5://172.22.1.1:20170 直接指定代理
#   PROXY_URL=https_proxy               间接引用：读 https_proxy 环境变量的值
# no_proxy 依然有效
# 注意：只在本地 vite dev 下读取本文件；Docker 部署请在 compose 的
# environment: 里设置（或 env_file），写进 .env.production 不会生效。
PROXY_URL=
